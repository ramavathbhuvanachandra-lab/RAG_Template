# =============================================================================
# Institutional RAG Chatbot Environment Configuration Template
# Copy this file to .env and adjust variables for your target institution.
# =============================================================================

# Target institution ID (matches ai_platform/institutions/<id>)
INSTITUTION_ID=iitj

# Ollama local inference endpoint
OLLAMA_BASE_URL=http://localhost:11434

# Canonical LLM models
QUERY_LLM_MODEL=qwen2.5:3b
ANSWER_LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0

# Optional: Vector database persistence root directory override (defaults to ./chroma_db)
# VECTORSTORE_PATH=./chroma_db

# Optional: Knowledge package root directory override
# RAG_PACKAGE_ROOT=./data/data_iitj/iit_jodhpur_rag_package_v2

# Optional: Active vectorstore collection name override
# VECTORSTORE_COLLECTION=iitj_v1

# Optional: Staging mode preview toggle (1 to preview staged release)
# RAG_USE_STAGING=0
